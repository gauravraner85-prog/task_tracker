rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny all paths by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 256;
      allow delete: if false;

      // Habits subcollection
      match /habits/{habitId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(habitId)
          && request.resource.data.userId == userId
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200;
        allow delete: if isOwner(userId);
      }

      // Goals subcollection
      match /goals/{goalId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(goalId)
          && request.resource.data.userId == userId
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200;
        allow delete: if isOwner(userId);
      }

      // Habit entries subcollection
      match /entries/{entryId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(entryId)
          && request.resource.data.userId == userId
          && request.resource.data.status in ['completed', 'missed', 'skipped'];
        allow delete: if isOwner(userId);
      }

      // Focus sessions subcollection
      match /focusSessions/{sessionId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(sessionId)
          && request.resource.data.userId == userId
          && request.resource.data.durationMinutes is number;
        allow delete: if isOwner(userId);
      }

      // Daily reflections subcollection
      match /reflections/{reflectionId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(reflectionId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      // Custom categories subcollection
      match /categories/{categoryId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(categoryId)
          && request.resource.data.userId == userId
          && request.resource.data.label is string
          && request.resource.data.label.size() <= 100;
        allow delete: if isOwner(userId);
      }

      // Achievements subcollection
      match /achievements/{achievementId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(achievementId)
          && request.resource.data.userId == userId
          && request.resource.data.badgeId is string;
        allow delete: if isOwner(userId);
      }
    }
  }
}
